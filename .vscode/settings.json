{
    "python.terminal.useEnvFile": true,
    "python.terminal.executeInFileDir": true,
    "python.linting.enabled": true,
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.formatOnSave": true
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/node_modules": true,
        "dist": false,
        ".env": false
    }
}